# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# `setup_env.sh` (and `uv run` after sourcing) loads these automatically.
# Do NOT commit your real `.env` — it is gitignored.

# HuggingFace token — for downloading gated models (e.g. Qwen-VL) and datasets.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# OpenRouter API key — used by the OpenRouter-based evaluators for closed-source
# LLMs (e.g. the VRT / VER eval scripts). Optional unless you run those.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Sa2VA training paths (consumed by training configs via os.environ).
# Point these at your local base model and data root; source .env before launching.
SA2VA_QWEN3VL_PATH=pretrained/qwen3vl/Qwen3-VL-4B-Instruct
SA2VA_DATA_ROOT=./data/
# Set to 1 only after SA-V (sam_v_full) is downloaded from Meta to enable Ref-SAV.
SA2VA_INCLUDE_REFSAV=0
# Grad-accum override; default 8 (16-gpu recipe). For 32 gpus use 4 to keep effective batch 128.
SA2VA_ACCUM=8

# SAM3 grounding encoder (sa2va_qwen3_4b_sam3.py). Uses the vendored SAM3 tracker
# (third_parts/sam3), so transformers stays at 4.57.1. SA2VA_SAM3_PATH = path to the
# assembled sam3.pt (relative to pretrained/sam3/ unless absolute);
# SA2VA_SAM3_IMG_SIZE = SAM3 tracker input resolution (native 1008).
SA2VA_SAM3_PATH=sam3.pt
SA2VA_SAM3_IMG_SIZE=1008
